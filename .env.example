# Z-Library Client App Configuration Template
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# Official Z-Library App Client Secret (extracted from APK)
EXPO_PUBLIC_ZLIB_CLIENT_SECRET=

# AES-128-CBC Decryption Key for dynamic domains
EXPO_PUBLIC_AES_KEY=

# Default API URL / Custom Cloudflare Worker Proxy
EXPO_PUBLIC_DEFAULT_API_URL=https://zlib.example.com
